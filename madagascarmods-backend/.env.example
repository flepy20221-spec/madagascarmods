# Database
DATABASE_URL=postgresql://user:password@host:5432/madagascarmods

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# Server
PORT=3000
NODE_ENV=production

# CORS
ALLOWED_ORIGINS=https://painel-adminstrador-production.up.railway.app

# ============================================================================
# LIMITES ANTI-FARM POR REDE (IP)
#
# Todos sao OPCIONAIS. Sem definir nada, o backend usa os padroes ja ajustados
# para CGNAT de operadora movel e nao bloqueia usuario legitimo.
#
# Contexto: Claro, Vivo e TIM usam CGNAT — milhares de celulares distintos
# compartilham um mesmo IPv4 publico (faixas como 152.233.x.x). Limites baixos
# por IP bloqueiam usuarios reais em massa com a mensagem "Muitas contas criadas
# nesta rede". O anti-farm efetivo e feito por APARELHO (indice unico em
# device_account_key e device_id), nao por IP.
#
# Suba estes valores se ainda houver relato de bloqueio indevido.
# Baixe-os apenas se detectar farm real vindo de um IP especifico.
# ============================================================================

# Aparelhos DISTINTOS que podem criar conta pelo mesmo IP em 24h. Padrao: 60
MAX_ACCOUNTS_PER_IP_24H=60

# Requisicoes em /api/auth/ por IP a cada 15 min (login + cadastro). Padrao: 120
AUTH_RATE_LIMIT_MAX=120

# Aparelhos por IP em 10 min que geram apenas REGISTRO no audit_log, sem bloquear
# (acao LOGIN_IP_BURST_OBSERVED). Serve para investigar sem punir. Padrao: 40
LOGIN_IP_SOFT_LIMIT=40

# Aparelhos por IP em 10 min que efetivamente BLOQUEIAM o login (429).
# Volume sem explicacao legitima nem sob CGNAT. Padrao: 200
LOGIN_IP_HARD_LIMIT=200

# FaucetPay API (for payment processing)
FAUCETPAY_API_KEY=your-faucetpay-api-key
FAUCETPAY_API_URL=https://faucetpay.io/api/v1

# AdMob SSV (Server-Side Verification)
ADMOB_SSV_KEY_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Firebase Admin SDK (Push Notifications)
# JSON completo da service account do Firebase (uma linha, sem quebras)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ============================================================================
# NOTIFICACOES ADMINISTRATIVAS (src/utils/adminNotifier.js)
#
# Avisam o admin quando ha algo aguardando acao humana: chave PIX enviada,
# e-mail FaucetPay enviado, saque solicitado e auto-ban executado.
#
# TODOS os canais sao opcionais e podem ser usados ao mesmo tempo. Sem nenhuma
# variavel definida, o sistema funciona exatamente como antes (nenhum aviso).
# ============================================================================

# --- Discord: webhook de canal. Recebe embeds coloridos com link para o painel.
# Criar em: Canal > Editar Canal > Integracoes > Webhooks > Novo Webhook
ADMIN_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/abcdef

# --- Telegram: bot + chat de destino. Entrega mais rapida no Android que o Discord.
# Token: falar com @BotFather. Chat ID: falar com @userinfobot (ou o ID do grupo, negativo).
ADMIN_TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
ADMIN_TELEGRAM_CHAT_ID=987654321

# --- ntfy: melhor opcao para push com PRIORIDADE real no Android (som mesmo no silencioso).
# Instale o app "ntfy" (Play Store / F-Droid) e inscreva-se no MESMO topico definido aqui.
# O topico funciona como senha: use um nome longo e aleatorio.
ADMIN_NTFY_TOPIC=cashpix-alertas-troque-por-algo-aleatorio
# Opcional: instancia propria em vez do ntfy.sh publico
ADMIN_NTFY_SERVER=https://ntfy.sh
# Opcional: token de acesso quando o topico for protegido
ADMIN_NTFY_TOKEN=tk_exemplo

# --- Webhook JSON generico: para n8n, Make, Zapier, IFTTT ou automacao propria.
ADMIN_GENERIC_WEBHOOK_URL=https://exemplo.com/hook/cashpix

# --- URL do painel. Torna a notificacao clicavel, abrindo direto a tela de aprovacao.
ADMIN_PANEL_URL=https://cashpix-admin-production.up.railway.app

# --- Filtro de categorias. Vazio ou ausente = recebe tudo.
# Categorias: approvals (chave PIX e e-mail), withdrawals (saques), security (ban e IP).
# Exemplo para receber so o que exige acao, sem alertas de seguranca:
ADMIN_NOTIFY_CATEGORIES=approvals,withdrawals,security

# --- Compatibilidade: variavel antiga do alerta de auto-ban. Continua funcionando como
# fallback do canal Discord quando ADMIN_DISCORD_WEBHOOK_URL nao esta definida.
BAN_WEBHOOK_URL=
